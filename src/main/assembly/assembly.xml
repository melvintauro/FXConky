<assembly xmlns="http://apache.org"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://apache.org http://apache.org">
    <id>excel-package</id>
    <formats>
        <!-- Change to jar, tar.gz, or dir as needed -->
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Option A: Package all .xls files from a specific directory -->
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/src/main/resources</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>*.xls</include>
                <include>*.xlsx</include>
            </includes>
            <!-- Keep filtered false so Maven does not corrupt binary Excel files -->
            <filtered>false</filtered>
        </fileSet>
    </fileSets>

    <!-- Option B: Package a single specific .xls file 
    <files>
        <file>
            <source>${project.basedir}/path/to/your-file.xls</source>
            <outputDirectory>/spreadsheets</outputDirectory>
            <destName>renamed-file.xls</destName>
            <filtered>false</filtered>
        </file>
    </files>-->
</assembly>
